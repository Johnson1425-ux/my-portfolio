# Copy to .env.local and adjust. Every value here is optional — the site builds
# and runs without any of them.

# Canonical site URL. Used for Open Graph tags, canonical links and the sitemap.
# Set this to your real domain before deploying.
NEXT_PUBLIC_SITE_URL=https://example.com

# GitHub account read by the open-source section. Defaults to the value in
# src/data/site.ts when unset.
NEXT_PUBLIC_GITHUB_USERNAME=Johnson1425-ux

# Optional. A fine-grained token with NO scopes is enough — it only raises the
# public API rate limit from 60 to 5,000 requests/hour. Server-side only: never
# prefix it with NEXT_PUBLIC_, and never commit a real token.
# GITHUB_TOKEN=
